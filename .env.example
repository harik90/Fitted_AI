# Model paths
FACE_MODEL_PATH=models/insightface
SEGMENTATION_MODEL_PATH=models/sam2
GENERATION_MODEL_PATH=models/instantid
RESTORATION_MODEL_PATH=models/gfpgan

# Device: auto | cpu | cuda
DEVICE=auto

# Pipeline
MAX_RETRIES=3
QUALITY_THRESHOLD=0.80

# Server Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Optional: Backend API URL for Frontend
# Leave blank for local development (defaults to Vite proxy / same-origin)
# Or set explicitly for separate backend hosting (e.g., http://localhost:8000)
VITE_API_URL=
